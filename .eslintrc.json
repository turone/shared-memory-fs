{
  "extends": ["metarhia", "plugin:prettier/recommended"],
  "env": {
    "browser": true,
    "es2022": true,
    "node": true
  },
  "parserOptions": {
    "ecmaVersion": "latest"
  },
  "rules": {
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "class-methods-use-this": "off",
    "import/no-unresolved": [
      "error",
      { "commonjs": true, "ignore": ["^shared-memory-fs(/|$)"] }
    ]
  },
  "overrides": [
    { "files": ["*.cjs"], "parserOptions": { "sourceType": "script" } },
    { "files": ["*.mjs"], "parserOptions": { "sourceType": "module" } }
  ]
}
