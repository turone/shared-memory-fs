{
  "name": "shared-memory-fs",
  "version": "1.0.0",
  "author": "Dmitriy Shyaryaiev <turone@ukr.net>",
  "description": "SharedArrayBuffer-backed filesystem cache for Node.js worker_threads",
  "license": "MIT",
  "keywords": [
    "cache",
    "sharedarraybuffer",
    "worker_threads",
    "filesystem",
    "node.js",
    "metarhia"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/turone/shared-memory-fs"
  },
  "bugs": {
    "url": "https://github.com/turone/shared-memory-fs/issues"
  },
  "homepage": "https://github.com/turone/shared-memory-fs",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./register": "./lib/bootstrap/register.mjs",
    "./adapters/fs-patch": "./lib/adapters/fs-patch.js",
    "./adapters/module-hook": "./lib/adapters/module-hook.js"
  },
  "files": [
    "lib/",
    "index.js"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "test:examples": "node --test \"test/examples-smoke.test.js\"",
    "lint": "eslint . && prettier -c \"**/*.js\" \"**/*.json\" \"**/*.md\"",
    "fix": "eslint . --fix && prettier --write \"**/*.js\" \"**/*.json\" \"**/*.md\""
  },
  "engines": {
    "node": ">=22.22.3 <23 || >=24.12.0 <25 || >=26"
  },
  "dependencies": {
    "metautil": "https://codeload.github.com/turone/metautil/tar.gz/d7794fe4f1589a4b65e8e14ab9b925cccde2a89b"
  },
  "devDependencies": {
    "@types/node": "^20.5.0",
    "eslint": "^8.47.0",
    "eslint-config-metarhia": "^8.2.2",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.0.0",
    "prettier": "^3.3.3"
  }
}
